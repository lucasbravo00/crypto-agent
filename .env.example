# Copy this file to ".env" and fill in what you use.
# NEVER commit the ".env" file to a public repo (it's already in .gitignore).

# ============ AGENT BRAIN ============
# "claude" (Anthropic API, minimal cost) or "ollama" (local model, free)
LLM_BACKEND=claude

# Only if LLM_BACKEND=claude: key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Only if LLM_BACKEND=ollama: local model already pulled (ollama pull llama3.1)
OLLAMA_MODEL=llama3.1

# Language of the generated report (ISO code: en, es, pt, ...)
REPORT_LANGUAGE=en

# ============ YOUTUBE CREATOR DIGEST (optional) ============
# When a channel you follow publishes a NEW video that is genuinely about
# crypto, the daily report adds a one-or-two-sentence synthesis of it.
# Off by default. Needs Supabase configured (it remembers which videos it
# already covered) and creator_videos table created -- see
# supabase/migration_creator_videos.sql.
YOUTUBE_DIGEST_ENABLED=false
# Comma-separated. Accepts @handles or raw UC... channel ids.
# e.g. YOUTUBE_CHANNELS=@CoinBureau,@AltcoinDaily
YOUTUBE_CHANNELS=

# Attach a PNG of the market context (price + SMA50/200 + RSI) to the
# daily report on channels that can show one: inline in the email, as the
# photo caption on Telegram. Set to false for text-only delivery.
# Failure here is never fatal -- a chart that can't be built is skipped
# and the report goes out anyway.
REPORT_CHART_ENABLED=true

# ============ REPORT OUTPUT CHANNEL ============
# console (terminal only) | email | telegram | all
NOTIFY_CHANNEL=console

# --- Email (deliver the report to your mailbox, e.g. Outlook) ---
# NOTE: Outlook no longer allows SENDING with plain username+password, so
# sending happens from ANOTHER SMTP service TO your Outlook mailbox.
# Recommended option A) Gmail with an "app password":
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_account@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# Option B) Brevo (free, no Gmail account needed): SMTP_HOST=smtp-relay.brevo.com
# with the login and SMTP key Brevo gives you.

# Mailbox where the report is delivered (your Outlook goes here):
EMAIL_TO=your_mailbox@outlook.com
# Sender (defaults to SMTP_USER if omitted):
EMAIL_FROM=your_account@gmail.com

# --- Telegram (optional, only if NOTIFY_CHANNEL=telegram or all) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============ MARKET ============
# Symbol to monitor (BingX/ccxt format)
SYMBOL=BTC/USDT

# ============ SUPABASE (state storage) ============
# Optional. If both are set, DCA purchases, bullets, and daily snapshots are
# stored in Supabase (Postgres) instead of the local state/ JSON file. This
# is what lets state be shared between your Mac and GitHub Actions. If unset,
# everything falls back to the local JSON file exactly as before.
# Project URL: Supabase dashboard -> Project Settings -> API -> Project URL
# (use the base URL, e.g. https://xxxxx.supabase.co -- NOT the /rest/v1/ path)
SUPABASE_URL=
# Use the "service_role" key (NOT "anon"), same screen as above. Treat this
# like a password: it has full read/write access and bypasses row security.
SUPABASE_KEY=

# ============ BINGX (demo/VST trading only) ============
# Optional. Only needed for src/bingx_client.py (reading/practicing on the
# BingX Demo Trading / VST account). Generate at bingx.com -> User Center ->
# API Management. IMPORTANT: BingX uses the SAME key for demo and live
# trading -- the separation is enforced entirely in code (bingx_client.py
# hard-codes sandbox/demo mode with no path to live). Start with a
# read-only key; only enable trading permissions once you actually need
# the agent to place demo orders.
BINGX_API_KEY=
BINGX_API_SECRET=

# Off by default -- must be the literal string "true" to enable. Gates
# src/bullets.py's auto_trade(): with it unset/false, the agent NEVER
# places an order, even if bullet-check runs every 15 min and the code
# to trade exists. This is a SECOND, independent safety switch on top of
# bingx_client.py's hard-coded demo mode -- both must agree before any
# order goes out. Only set this once you've tested with
# `python main.py bingx-auto-trade --test` and reviewed the result.
BINGX_AUTO_TRADE_ENABLED=false
